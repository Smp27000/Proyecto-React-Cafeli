						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombres\": \"Carlos\",\n    \"apellidos\": \"Gomez\",\n    \"tipo_documento\": \"CC\",\n    \"numero_documento\": \"12345678\",\n    \"direccion\": \"Calle 10 # 5-4\",\n    \"telefono\": \"3104567890\",\n    \"email\": \"carlos.cliente@correo.com\",\n    \"password\": \"Segura1234\",\n    \"rol_id\": 2\n}"
