				{
					"name": "Inicio de Sesión (Genera JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.token) {",
									"    pm.collectionVariables.set(\"token\", response.token);",
									"    console.log(\"Token JWT guardado automáticamente en variables de la colección.\");",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"ana.admin@correo.com\",\n    \"password\": \"Admin98765\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Inicia sesión con las credenciales de un usuario activo. Al completarse con éxito, guarda el JWT retornado en la variable `{{token}}` automáticamente."
					},
					"response": []
				},
				{
					"name": "Inicio de Sesión - Empleado (Genera JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.token) {",
									"    pm.collectionVariables.set(\"token\", response.token);",
									"    console.log(\"Token JWT de Empleado guardado automáticamente en variables de la colección.\");",
									"}"
								],
								"type": "javascript"
							}
						}
					],
