		{
			"name": "2. Gestión de Usuarios (Protegidos)",
			"item": [
				{
					"name": "Consulta de Usuarios",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/usuarios",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"usuarios"
							]
						},
						"description": "Obtiene el listado de todos los usuarios registrados. Requiere autorización Bearer JWT (con rol Administrador)."
					},
					"response": []
				},
				{
					"name": "Actualización de Usuario",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombres\": \"Carlos Andres\",\n    \"apellidos\": \"Gomez P.\",\n    \"tipo_documento\": \"CC\",\n    \"numero_documento\": \"12345678\",\n    \"direccion\": \"Calle Nueva # 12-34\",\n    \"telefono\": \"3109999999\",\n    \"email\": \"carlos.cliente@correo.com\",\n    \"rol_id\": 2\n}"
						},
						"url": {
							"raw": "{{base_url}}/usuarios/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"usuarios",
								"1"
							]
						},
						"description": "Actualiza la información del usuario con ID 1 (reemplazar con un ID existente). Requiere autorización Bearer JWT."
					},
					"response": []
				},
				{
					"name": "Cambio de Estado (Activo / Inactivo)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"estado\": \"Inactivo\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/usuarios/1/estado",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"usuarios",
								"1",
								"estado"
							]
						},
						"description": "Cambia el estado de un usuario (Activo/Inactivo). Requiere autorización Bearer JWT (con rol Administrador)."
					},
					"response": []
				},
				{
					"name": "Eliminación de Usuario",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/usuarios/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"usuarios",
								"1"
							]
						},
						"description": "Elimina el usuario con ID 1 (reemplazar con un ID existente). Requiere autorización Bearer JWT."
					},
					"response": []
				},
				{
					"name": "Acceso Denegado (Sin Token JWT)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/usuarios",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"usuarios"
							]
						},
						"description": "Intento de consultar usuarios sin enviar la cabecera Authorization JWT, lo cual retornará un estado 401 (No Autorizado)."
					},
					"response": []
				}
			]
		},
		{
